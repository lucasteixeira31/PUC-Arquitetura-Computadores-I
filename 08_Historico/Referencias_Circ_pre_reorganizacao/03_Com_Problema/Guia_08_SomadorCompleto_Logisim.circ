<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Arithmetic" name="3"/>
  <main name="main"/>

  <circuit name="main">
    <a name="circuit" val="main"/>

    <!-- Somador completo demonstrativo -->
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="label" val="A"/>
    </comp>
    <comp lib="0" loc="(100,160)" name="Pin">
      <a name="label" val="B"/>
    </comp>
    <comp lib="0" loc="(100,220)" name="Pin">
      <a name="label" val="Cin"/>
    </comp>

    <comp lib="1" loc="(250,130)" name="XOR Gate"/>
    <comp lib="1" loc="(250,220)" name="XOR Gate"/>
    <comp lib="1" loc="(380,130)" name="AND Gate"/>
    <comp lib="1" loc="(380,220)" name="AND Gate"/>
    <comp lib="1" loc="(500,170)" name="OR Gate"/>

    <comp lib="0" loc="(620,130)" name="Probe">
      <a name="label" val="S"/>
    </comp>
    <comp lib="0" loc="(620,220)" name="Probe">
      <a name="label" val="Cout"/>
    </comp>

    <wire from="(100,100)" to="(200,100)"/>
    <wire from="(100,160)" to="(200,160)"/>
    <wire from="(100,220)" to="(200,220)"/>

    <wire from="(200,100)" to="(250,130)"/>
    <wire from="(200,160)" to="(250,130)"/>
    <wire from="(250,130)" to="(300,130)"/>
    <wire from="(300,130)" to="(250,220)"/>
    <wire from="(200,220)" to="(250,220)"/>

    <wire from="(300,130)" to="(380,130)"/>
    <wire from="(300,130)" to="(380,220)"/>
    <wire from="(200,100)" to="(380,220)"/>
    <wire from="(200,160)" to="(380,130)"/>

    <wire from="(250,220)" to="(620,130)"/>
    <wire from="(380,130)" to="(500,170)"/>
    <wire from="(380,220)" to="(500,170)"/>
    <wire from="(500,170)" to="(620,220)"/>

  </circuit>
</project>
