<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#Input/Output" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simFrequency" val="1.0"/>
  </options>
  <mappings>
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="6" name="Wiring Tool"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <comp lib="1" loc="(180,120)" name="AND Gate"/>
    <comp lib="1" loc="(180,180)" name="XOR Gate"/>
    <comp lib="1" loc="(280,150)" name="OR Gate"/>
    <comp lib="5" loc="(100,100)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="5" loc="(100,160)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
    </comp>
    <comp lib="5" loc="(100,220)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="Cin"/>
    </comp>
    <comp lib="5" loc="(360,150)" name="Probe">
      <a name="label" val="S"/>
    </comp>
    <wire from="(100,100)" to="(150,100)"/>
    <wire from="(100,160)" to="(150,160)"/>
    <wire from="(100,220)" to="(280,220)"/>
    <wire from="(150,100)" to="(150,180)"/>
    <wire from="(150,180)" to="(180,180)"/>
    <wire from="(150,100)" to="(180,120)"/>
    <wire from="(150,160)" to="(180,160)"/>
    <wire from="(180,120)" to="(220,120)"/>
    <wire from="(180,180)" to="(220,180)"/>
    <wire from="(220,120)" to="(280,120)"/>
    <wire from="(220,180)" to="(280,180)"/>
    <wire from="(280,150)" to="(360,150)"/>
  </circuit>
</project>
